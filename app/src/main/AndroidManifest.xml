<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Conversão para MP3 em serviço de primeiro plano (continua ao sair da app) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Notificação de progresso (Android 13+ pede autorização) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Manter o CPU acordado com o ecrã desligado durante a conversão -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:theme="@style/Theme.MiniTag"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".ConversionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>
</manifest>
